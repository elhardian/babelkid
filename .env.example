# Auth session signing
AUTH_SECRET=change-me-to-a-long-random-string

# MySQL (Prisma) — connection string is required
DATABASE_URL="mysql://root:password@127.0.0.1:3306/babelkid"
# Optional pool size (default 10)
# DATABASE_POOL_SIZE=10

# MinIO (S3-compatible) — used for kegiatan foto upload
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=babelkid
MINIO_REGION=us-east-1
# Optional override for public object URLs
# MINIO_PUBLIC_URL=http://localhost:9000/babelkid
